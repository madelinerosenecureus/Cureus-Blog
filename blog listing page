<!--
  templateType: blog_listing
  isAvailableForNewContent: true
  label: Cureus Blog Listing Page
-->
<!DOCTYPE html>
<html lang="{{ html_lang }}" {{ html_lang_dir }}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page_meta.html_title }}</title>
  <meta name="description" content="{{ page_meta.meta_description }}">
  {{ standard_header_includes }}
  {# Site fonts: Roboto Slab (headings) + Inter (body), both from Google Fonts. #}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Fonts (Inter + Roboto Slab) are self-declared via @font-face in the CSS below.
       The Google Fonts stylesheet link was removed because its subset-based faces
       conflicted with and blocked reliable loading on this page. -->
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    /* Direct @font-face — loads the full variable fonts reliably. Google Fonts' lazy per-weight
       loading intermittently fails to apply on some HubSpot pages, so we declare the faces here. */
    @font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url('https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2') format('woff2');}
    @font-face{font-family:'Roboto Slab';font-style:normal;font-weight:100 900;font-display:swap;src:url('https://fonts.gstatic.com/s/robotoslab/v36/BngMUXZYTXPIvIBgJJSb6ufN5qWr4xCC.woff2') format('woff2');}
    :root{
      --teal:#1a9fbd;          /* primary accent */
      --teal-dark:#127f99;
      --ink:#000;              /* headings (match About page) */
      --body:#475158;          /* body text */
      --muted:#8a929a;         /* meta/dates */
      --line:#e7ebee;          /* hairlines */
      --serif: 'Roboto Slab', Georgia, 'Times New Roman', serif;  /* headings */
      --sans:'Inter','Helvetica Neue',Arial,sans-serif;          /* body */
      --maxw:1280px;
      --grad: radial-gradient(120% 120% at 30% 25%, #bfe6f4 0%, #66bfdf 45%, #1f9ad0 100%);
      --grad-soft: linear-gradient(135deg,#e6f3fa 0%, #d2ebf6 100%);
    }
    body { margin:0; font-family:var(--sans); color:var(--body); background:#fff; -webkit-font-smoothing:antialiased; }
    a{ color:inherit; }
    img{ border-radius:0 !important; } /* all images render with square corners */
    .wrap{ max-width:var(--maxw); margin:0 auto; padding:0 40px; }

    /* ───────────────────────── NAV ───────────────────────── */
    .nav{ border-bottom:1px solid var(--line); background:#fff; }
    .nav__inner{ display:flex; align-items:center; gap:28px; max-width:var(--maxw); margin:0 auto; padding:18px 40px; }
    .nav__menu{ display:flex; align-items:center; gap:26px; list-style:none; margin:0; padding:0; flex:1; }
    .nav__menu > li{ position:relative; }
    .nav__link{ font-size:15px; color:#73797e; text-decoration:none; white-space:nowrap; }
    .nav__link:hover{ color:var(--teal); }
    .nav__menu > li:hover .nav__dd{ display:block; }
    /* Transparent bridge across the 14px gap so the dropdown stays open while the cursor moves onto it */
    .nav__dd::before{ content:""; position:absolute; left:0; right:0; top:-14px; height:14px; }
    .nav__dd{ display:none; position:absolute; top:100%; left:0; margin-top:14px; background:#fff; border:1px solid var(--line);
      list-style:none; padding:6px 0; min-width:210px; z-index:200; box-shadow:0 10px 30px rgba(20,40,60,.10); border-radius:8px; }
    .nav__dd li a{ display:block; padding:9px 18px; font-size:14px; color:#2b3137; text-decoration:none; }
    .nav__dd li a:hover{ background:#f5fafc; color:var(--teal); }
    .nav__right{ display:flex; align-items:center; gap:18px; }
    .nav__cta{ display:inline-flex; align-items:center; gap:10px; background:#0096b7; color:#fff; text-decoration:none; font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:normal; padding:13px 16px; border-radius:8px; white-space:nowrap; }
    .nav__cta svg{ flex-shrink:0; }
    .nav__cta:hover{ background:#007e99; }
    .nav__avatar{ width:40px; height:40px; border-radius:50%; background:var(--grad); flex-shrink:0; display:block; object-fit:cover; }

    /* blog sub-nav (second row, opposite side from main menu) */
    .subnav{ border-bottom:1px solid var(--line); background:#fff; }
    .subnav__inner{ display:flex; justify-content:center; max-width:var(--maxw); margin:0 auto; padding:0 40px; }
    .subnav__menu{ display:flex; align-items:center; gap:22px; list-style:none; margin:0; padding:0; }
    .subnav__menu > li{ position:relative; }
    .subnav__link{ display:flex; align-items:center; height:48px; font-size:14px; color:#52606b; text-decoration:none; white-space:nowrap; }
    .subnav__link:hover{ color:var(--teal); }
    .subnav__menu > li:hover .subnav__dd{ display:block; }
    .subnav__dd{ display:none; position:absolute; top:100%; right:0; background:#fff; border:1px solid var(--line); list-style:none;
      margin:0; padding:6px 0; min-width:220px; z-index:200; box-shadow:0 10px 30px rgba(20,40,60,.10); border-radius:8px; }
    .subnav__dd li a{ display:block; padding:9px 18px; font-size:14px; color:#2b3137; text-decoration:none; }
    .subnav__dd li a:hover{ background:#f5fafc; color:var(--teal); }

    /* ───────────────────────── HERO ───────────────────────── */
    /* No horizontal padding here — the inner .wrap supplies the 40px gutter so the
       hero/search width lines up exactly with the content columns below. */
    .hero{ text-align:center; padding:46px 0 0; }
    .hero__title{ font-family:var(--serif); font-weight:600; color:var(--ink); font-size:24px; line-height:38px; letter-spacing:-0.02em; text-transform:uppercase; margin:0; }
    .hero__eyebrow{ color:var(--teal); font-size:11px; font-weight:700; letter-spacing:.18em; text-transform:uppercase; margin:10px 0 0; }

    .hero__card{ position:relative; margin:26px auto 0; border-radius:0; background:var(--grad-soft);
      padding:78px 30px 86px; overflow:hidden; }
    .hero__card h2{ font-family:var(--serif); font-weight:600; color:#000; font-size:24px; line-height:32px; margin:0; }
    .hero__card p{ color:#5a6b78; font-size:18px; margin:18px auto 0; max-width:620px; line-height:1.6; }

    /* search / results bar */
    .searchbar{ display:flex; align-items:center; gap:14px; border:1px solid #d9dee2; border-radius:0;
      background:#fff; padding:10px 12px 10px 18px; margin:22px auto 0; box-shadow:0 1px 2px rgba(20,40,60,.04); }
    .searchbar__icon{ color:#9aa2a9; flex-shrink:0; display:flex; }
    .searchbar input{ flex:1; border:none; outline:none; font-family:inherit; font-size:15px; color:#333; min-width:0; background:transparent; }
    .searchbar input::placeholder{ color:#9aa2a9; font-style:italic; }
    .searchbar__count{ font-size:12px; color:#8a929a; letter-spacing:.04em; white-space:nowrap; }
    .searchbar__count b{ color:#5a6b78; font-weight:600; }
    .btn-filters{ display:inline-flex; align-items:center; gap:8px; background:var(--teal); color:#fff; border:none;
      font-family:inherit; font-size:13px; font-weight:600; letter-spacing:.04em; padding:11px 18px; border-radius:7px; cursor:pointer; white-space:nowrap; }
    .btn-filters:hover{ background:var(--teal-dark); }
    .filters-wrap{ position:relative; }
    .filters-wrap:hover .filters-dd, .filters-wrap:focus-within .filters-dd{ display:block; }
    .filters-dd{ display:none; position:absolute; top:100%; left:0; margin-top:8px; background:#fff; border:1px solid var(--line);
      list-style:none; padding:6px 0; min-width:220px; z-index:200; box-shadow:0 10px 30px rgba(20,40,60,.10); border-radius:8px; text-align:left; }
    .filters-dd li a{ text-align:left; }
    .filters-dd li a{ display:block; padding:9px 18px; font-size:14px; color:#2b3137; text-decoration:none; }
    .filters-dd li a:hover{ background:#f5fafc; color:var(--teal); }
    .btn-search{ background:#fff; border:1px solid #d9dee2; color:#2b3137; font-family:inherit; font-size:14px;
      padding:10px 20px; border-radius:7px; cursor:pointer; }
    .btn-search:hover{ border-color:var(--teal); color:var(--teal); }
    .btn-x{ background:#fff; border:1px solid #d9dee2; color:#6b7178; width:40px; height:40px; border-radius:7px;
      cursor:pointer; font-size:16px; line-height:1; display:flex; align-items:center; justify-content:center; }
    .btn-x:hover{ border-color:var(--teal); color:var(--teal); }

    /* ─────────────── FEATURED CAROUSEL ─────────────── */
    .featured{ margin:30px auto 0; border:1px solid var(--line); border-radius:0; overflow:hidden; display:flex; height:390px;
      box-shadow:0 6px 24px rgba(20,40,60,.06); }
    .featured__img{ width:46%; min-height:330px; background:#fff; flex-shrink:0; position:relative; }
    .featured__img img{ width:100%; height:100%; object-fit:cover; display:block; }
    /* carousel image slides (stacked, cross-fade) */
    .featured__slide-img{ position:absolute; inset:0; display:block; opacity:0; transition:opacity .35s ease; pointer-events:none; }
    .featured__slide-img.is-active{ opacity:1; pointer-events:auto; }
    .featured__slide-img img{ width:100%; height:100%; object-fit:cover; display:block; }
    .featured__body{ flex:1; padding:48px 52px; display:flex; flex-direction:column; min-height:0; }
    /* text area grows to fill and scrolls if the post is long, so controls stay pinned to the bottom */
    .featured__slides{ flex:1 1 auto; min-height:0; overflow:hidden; }
    /* carousel text slides (show active only) */
    .featured__slide{ display:none; }
    .featured__slide.is-active{ display:block; }
    /* Title is never truncated — it may use as many lines as it needs; the excerpt below
       gives up space for it (see the clampExcerpt() logic in the carousel script). */
    .featured__title{ font-family:var(--serif); font-weight:600; color:var(--ink); font-size:20px; line-height:26px; letter-spacing:.02em; margin:0; max-width:380px; }
    .featured__title a{ text-decoration:none; color:inherit; }
    .featured__title a:hover{ color:var(--teal); }
    /* Clamp every excerpt to 4 lines with a trailing ellipsis so long meta descriptions
       and short summaries render identically — no scroll bar, consistent height. */
    /* Base clamp is 4 lines; the carousel script narrows it further per-slide when a long
       title needs the room, so the excerpt always ends in a clean ellipsis (never a mid-line cut). */
    .featured__excerpt{ color:var(--body); font-size:18px; line-height:1.75; margin:16px 0 20px; max-width:430px;
      display:-webkit-box; -webkit-line-clamp:5; line-clamp:5; -webkit-box-orient:vertical; overflow:hidden; }
    .featured__controls{ display:flex; align-items:center; gap:26px; margin-top:20px; flex-shrink:0; }
    .carousel-arrows{ display:flex; gap:14px; }
    .carousel-arrow{ width:44px; height:44px; border-radius:50%; border:1px solid #d4dade; background:#fff; color:#4a5560;
      display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px; }
    .carousel-arrow:hover{ border-color:var(--teal); color:var(--teal); }
    .carousel-dots{ display:flex; gap:9px; align-items:center; }
    .carousel-dot{ width:8px; height:8px; border-radius:50%; background:#d2d8dd; border:none; padding:0; cursor:pointer; transition:background .2s ease; }
    .carousel-dot:hover{ background:#a8b1b8; }
    .carousel-dot.is-active{ background:var(--teal); }
    .btn-readmore{ margin-left:auto; align-self:flex-start; border:1px solid #d4dade; background:#fff; color:#2b3137;
      text-decoration:none; font-size:14px; padding:11px 22px; border-radius:7px; }
    .btn-readmore:hover{ border-color:var(--teal); color:var(--teal); }

    /* ─────────────── SECTIONS ─────────────── */
    /* Full-width divider between stacked sections (Knowledge / Community / News) */
    .section{ margin-top:40px; padding-top:40px; border-top:1px solid var(--line); }
    .section__head{ display:flex; align-items:flex-start; justify-content:space-between; gap:24px; margin-bottom:26px; padding-bottom:20px; border-bottom:1px solid var(--line); }
    .section__title{ font-family:var(--serif); font-weight:600; color:var(--ink); font-size:24px; line-height:30px; letter-spacing:.04em; text-transform:uppercase; margin:0; }
    .section__sub{ color:var(--teal); font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; margin:9px 0 0; }
    .btn-viewall{ flex-shrink:0; display:inline-flex; align-items:center; gap:8px; border:1px solid #d4dade; background:#fff;
      color:#2b3137; text-decoration:none; font-size:14px; padding:10px 20px; border-radius:7px; white-space:nowrap; }
    .btn-viewall:hover{ border-color:var(--teal); color:var(--teal); }

    /* card grid */
    .cards{ display:grid; grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); gap:26px; }
    .card{ display:flex; flex-direction:column; }
    .card__img{ width:100%; aspect-ratio:1200/630; border-radius:0; background:var(--grad); object-fit:cover; display:block; }
    .card__meta{ display:flex; align-items:center; gap:10px; margin:16px 0 8px; flex-wrap:wrap; }
    .card__tag{ color:var(--teal); font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }
    .card__tag--open{ color:#1f9ad0; }
    .card__date{ color:var(--muted); font-size:11px; letter-spacing:.06em; text-transform:uppercase; }
    .card__title{ font-family:var(--serif); font-weight:600; color:var(--ink); font-size:20px; line-height:26px; margin:0; }
    .card__title a{ text-decoration:none; color:inherit; }
    .card__title a:hover{ color:var(--teal); }
    .card__stats{ display:flex; align-items:center; gap:22px; margin-top:auto; padding-top:16px; }
    .stat{ display:flex; align-items:center; gap:7px; color:var(--muted); font-size:12px; }
    .stat svg{ flex-shrink:0; }

    /* community asymmetric layout */
    .cards--community{ grid-template-columns:repeat(auto-fit, minmax(240px, 1fr)); align-items:stretch; }
    .card--wide .card__img{ aspect-ratio:1200/630; }
    .card--wide .card__title{ font-size:20px; line-height:1.3; }
    .card--wide .card__meta{ margin-top:18px; }

    /* Vertical hairline dividers between cards (magazine style, like cureus.com) — desktop only */
    @media (min-width:1000px){
      .cards > .card{ position:relative; }
      .cards > .card + .card::before{
        content:""; position:absolute; top:0; bottom:0; left:-13px; width:1px; background:var(--line);
      }
    }

    /* ─────────────── NEWSLETTER + FOOTER ─────────────── */
    .site-footer{ background:#f4f5f6; border-top:1px solid var(--line); margin-top:70px; }
    .footer-cols{ display:flex; max-width:var(--maxw); margin:0 auto; padding:46px 40px 30px; gap:0; }
    .footer-col{ flex:1; padding:0 28px; border-right:1px solid #e2e5e8; }
    .footer-col:first-child{ padding-left:0; }
    .footer-col:last-child{ border-right:none; padding-right:0; }
    .footer-col h4{ font-family:var(--serif); font-size:20px; font-weight:600; color:#000; margin:0 0 16px; }
    .footer-col a{ display:block; font-family:var(--serif); font-size:16px; font-weight:500; color:#73797e; text-decoration:none; margin-bottom:10px; }
    .footer-col a:hover{ color:var(--teal); }

    .newsletter{ border-top:1px solid #e2e5e8; }
    .newsletter__inner{ max-width:var(--maxw); margin:0 auto; padding:34px 40px; display:flex; align-items:center; justify-content:space-between; gap:30px; flex-wrap:wrap; }
    .newsletter__title{ font-family:var(--serif); font-weight:600; color:#000; font-size:24px; line-height:30px; margin:0; max-width:560px; text-transform:uppercase; letter-spacing:.02em; }
    .newsletter__form{ display:flex; gap:10px; }
    .newsletter__form input{ border:1px solid #d4dade; background:#fff; border-radius:8px; padding:13px 18px; font-family:inherit; font-size:14px; min-width:300px; outline:none; }
    .newsletter__form input:focus{ border-color:var(--teal); }
    .newsletter__form button{ background:var(--teal); border:1px solid var(--teal); border-radius:8px; padding:13px 26px; font-family:inherit; font-size:14px; cursor:pointer; color:#fff; }
    .newsletter__form button:hover{ background:var(--teal-dark); border-color:var(--teal-dark); color:#fff; }
    .footer-bottom{ border-top:1px solid #e2e5e8; }
    .footer-bottom__inner{ max-width:var(--maxw); margin:0 auto; padding:18px 40px; display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; font-size:13px; color:#6b7278; }
    .footer-bottom__inner a{ color:#6b7278; text-decoration:none; }
    .footer-bottom__inner a:hover{ color:var(--teal); }

    /* ─────────────── SEARCH / TAG LIST VIEW ─────────────── */
    .listing{ max-width:900px; margin:46px auto; padding:0 40px; }
    .listing__back{ color:var(--teal); font-size:14px; text-decoration:none; }
    .listing__heading{ color:var(--ink); font-family:var(--serif); font-size:24px; line-height:30px; font-weight:600; margin:14px 0 4px; }
    .listing__count{ color:var(--muted); font-size:14px; margin:0 0 28px; }
    .post-row{ display:flex; gap:24px; padding:26px 0; border-bottom:1px solid var(--line); align-items:flex-start; }
    .post-row__thumb{ width:180px; height:120px; border-radius:0; object-fit:cover; flex-shrink:0; background:var(--grad); display:block; }
    .post-row__body{ flex:1; min-width:0; }
    .post-row__title{ font-family:var(--serif); font-size:20px; font-weight:600; color:var(--ink); text-decoration:none; }
    .post-row__title:hover{ color:var(--teal); }
    .post-row__body p{ color:var(--body); margin:8px 0 0; line-height:1.6; font-size:18px; }
    .post-row__meta{ font-size:12px; color:var(--muted); margin-top:8px; letter-spacing:.04em; text-transform:uppercase; }
    .pagination-wrap{ text-align:center; margin:40px 0; }

    /* ─────────────── RESPONSIVE ─────────────── */
    @media (max-width:1000px){
      .cards{ grid-template-columns:repeat(2,1fr); }
      .cards--community{ grid-template-columns:1fr; }
      .hero__card h2{ font-size:22px; }
    }
    @media (max-width:820px){
      .nav__menu, .subnav__menu{ display:none; }
      .featured{ flex-direction:column; height:auto; }
      .featured__img{ width:100%; min-height:220px; }
      .featured__body{ padding:32px 26px; }
      .section__head{ flex-direction:column; }
      .footer-cols{ flex-wrap:wrap; gap:24px 0; }
      .footer-col{ flex:1 1 45%; border-right:none; padding:0 0 0 0; }
      .newsletter__form input{ min-width:0; flex:1; }
    }
    @media (max-width:560px){
      .wrap, .footer-cols, .newsletter__inner, .footer-bottom__inner{ padding-left:20px; padding-right:20px; }
      .cards{ grid-template-columns:1fr; }
      .hero__card{ padding:48px 20px 56px; }
      .hero__card h2{ font-size:20px; }
      .hero__title{ font-size:22px; }
      .searchbar{ flex-wrap:wrap; }
      .post-row__thumb{ width:110px; height:80px; }
    }
    /* Search bar on small screens: input keeps a full row (so "Search the blog…" never
       clips) and the Filters / Search buttons drop to a second row. */
    @media (max-width:640px){
      .searchbar{ flex-wrap:wrap; row-gap:10px; }
      .searchbar__icon{ order:1; }
      .searchbar input{ order:1; flex:1 1 auto; min-width:0; }
      .filters-wrap{ order:2; flex:1 1 45%; }
      .btn-filters{ width:100%; justify-content:center; }
      .btn-search{ order:2; flex:1 1 45%; }
    }
  </style>
</head>
<body>

{# ───────────────────────── NAV ───────────────────────── #}
{% set primary_menu = menu(213273198154) %}
<nav class="nav" aria-label="Primary navigation">
  <div class="nav__inner">
    <!-- Cureus site logo, links to main site; sits left of the Home menu item -->
    <a class="nav__logo" href="https://www.cureus.com" aria-label="Cureus" style="display:inline-flex;align-items:center;flex-shrink:0;text-decoration:none;">
      <img src="data:image/png;base64," alt="Cureus — Part of Springer Nature" style="height:44px;width:auto;display:block;">
    </a>
    <ul class="nav__menu">
      {% for item in primary_menu.children %}
        <li>
          <a href="{{ item.url }}" class="nav__link">{{ item.label }}</a>
          {% if item.children %}
            <ul class="nav__dd">
              {% for child in item.children %}
                <li><a href="{{ child.url }}">{{ child.label }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
    <div class="nav__right">
      <a href="https://cta-service-cms2.hubspot.com/web-interactives/public/v1/track/redirect?encryptedPayload=AVxigLIUze30gran83%2F5iKfzAUPkH22WffugIDc64rInWoxdEWTq1PY7NqbW3OGhWgijdqvW8Ei2q4%2FTug5YDpSgw1Lwd744xWbQOKh0QZsdBVZlz34PoiyLHRXcJR4aW0m2xUYBMTu2pmNX28hhtOKDzJ9lAyLtpqtR2W7mj9KkDQsPvr1QOUtPOnVA32ChLxg%3D&amp;webInteractiveContentId=205845548937&amp;portalId=46589883" class="nav__cta" target="_blank" rel="noopener noreferrer" crossorigin="anonymous">Submit Research <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg></a>
    </div>
  </div>
</nav>

{# ── BLOG SUB-NAV (second row, right-aligned) ── #}
{% set secondary_menu = menu(213273197925) %}
<nav class="subnav" aria-label="Blog navigation">
  <div class="subnav__inner">
    <ul class="subnav__menu">
      {% for item in secondary_menu.children %}
        <li>
          <a href="{{ item.url }}" class="subnav__link">{{ item.label }}</a>
          {% if item.children %}
            <ul class="subnav__dd">
              {% for child in item.children %}
                <li><a href="{{ child.url }}">{{ child.label }}</a></li>
              {% endfor %}
            </ul>
          {% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</nav>

{# ───────────────────────── HERO ───────────────────────── #}
<header class="hero">
  <div class="wrap">
    <h1 class="hero__title">Cureus Journal of Medical Science Blog</h1>
    <p class="hero__eyebrow">Blog &amp; Cureus News</p>

    <div class="hero__card">
