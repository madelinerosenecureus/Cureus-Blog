<script>
  (function () {
    document.querySelectorAll('.featured[data-carousel]').forEach(function (car) {
      var imgs   = car.querySelectorAll('.featured__slide-img');
      var slides = car.querySelectorAll('.featured__slide');
      var dots   = car.querySelectorAll('.carousel-dot');
      var prev   = car.querySelector('[data-prev]');
      var next   = car.querySelector('[data-next]');
      var readmore = car.querySelector('[data-readmore]');
      var slidesBox = car.querySelector('.featured__slides');
      var n = slides.length;
      var i = 0;

      /* Give the title all the lines it needs, then let the excerpt take whatever vertical
         space is left — clamped to a whole number of lines that fit (max 4) with an ellipsis.
         A long title therefore "eats" the excerpt's space cleanly instead of the excerpt
         being hard-clipped mid-line by the fixed-height box. */
      function clampExcerpt() {
        if (!slidesBox) { return; }
        var active = slides[i];
        if (!active) { return; }
        var title = active.querySelector('.featured__title');
        var exc   = active.querySelector('.featured__excerpt');
        if (!exc) { return; }
        exc.style.webkitLineClamp = '';
        var cs = window.getComputedStyle(exc);
        var lineH = parseFloat(cs.lineHeight) || 30;
        var mt = parseFloat(cs.marginTop) || 0;
        var mb = parseFloat(cs.marginBottom) || 0;
        var titleH = title ? title.offsetHeight : 0;
        var avail = slidesBox.clientHeight - titleH - mt - mb;
        var lines = Math.floor(avail / lineH);
        if (lines < 1) { lines = 1; }
        if (lines > 5) { lines = 5; }
        exc.style.webkitLineClamp = String(lines);
      }

      function show(k) {
        i = (k + n) % n;
        imgs.forEach(function (el, idx) { el.classList.toggle('is-active', idx === i); });
        slides.forEach(function (el, idx) { el.classList.toggle('is-active', idx === i); });
        dots.forEach(function (el, idx) { el.classList.toggle('is-active', idx === i); });
        if (readmore) {
          var link = slides[i].querySelector('a[href]');
          if (link) { readmore.setAttribute('href', link.getAttribute('href')); }
        }
        clampExcerpt();
      }

      if (prev) { prev.addEventListener('click', function () { show(i - 1); }); }
      if (next) { next.addEventListener('click', function () { show(i + 1); }); }
      dots.forEach(function (dot, idx) {
        dot.addEventListener('click', function () { show(idx); });
      });

      /* Recompute when the layout can change: viewport resize (title wrap count shifts)
         and after the web fonts load (font swap changes the title's height). */
      var _rt;
      window.addEventListener('resize', function () { clearTimeout(_rt); _rt = setTimeout(clampExcerpt, 120); });
      if (document.fonts && document.fonts.ready) { document.fonts.ready.then(clampExcerpt); }

      show(0);
    });
  })();
</script>
<script>
  /* Newsletter -> submits to the HubSpot form's API, which records a real form
     submission (so form-triggered workflows still fire). Portal 46589883, form 4969c11e-... */
  (function(){
    var ENDPOINT='https://api.hsforms.com/submissions/v3/integration/submit/46589883/4969c11e-c011-42c4-a1e1-3878c72f7aa2';
    document.querySelectorAll('form[data-hsform]').forEach(function(f){
      f.addEventListener('submit', function(e){
        e.preventDefault();
        var input=f.querySelector('input[type="email"]');
        var email=input?input.value.trim():'';
        if(!email) return;
        var btn=f.querySelector('button');
        if(btn){ btn.disabled=true; btn.textContent='Subscribing…'; }
        var hutk=(document.cookie.match(/hubspotutk=([^;]+)/)||[])[1];
        var ctx={ pageUri:location.href, pageName:document.title };
        if(hutk){ ctx.hutk=hutk; }
        fetch(ENDPOINT,{
          method:'POST',
          headers:{'Content-Type':'application/json'},
          body:JSON.stringify({ fields:[{name:'email',value:email}], context:ctx })
        }).then(function(r){
          if(r.ok){
            f.innerHTML='<span style="font-family:\'Inter\',\'Helvetica Neue\',Arial,sans-serif;font-size:15px;font-weight:500;color:#1a9fbd;">Thanks — you\'re subscribed!</span>';
          } else {
            if(btn){ btn.disabled=false; btn.textContent='Subscribe'; }
            r.json().then(function(d){ alert((d&&d.message)||'Sorry, something went wrong. Please try again.'); }).catch(function(){ alert('Sorry, something went wrong. Please try again.'); });
          }
        }).catch(function(){
          if(btn){ btn.disabled=false; btn.textContent='Subscribe'; }
          alert('Network error. Please try again.');
        });
      });
    });
  })();
</script>
