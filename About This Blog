<!DOCTYPE html>
<html lang="{{ html_lang }}" {{ html_lang_dir }}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ content.html_title }}</title>
  {{ standard_header_includes }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <!-- Fonts (Inter + Roboto Slab) are self-declared via @font-face in the CSS below.
       The Google Fonts stylesheet link was removed because its subset-based faces
       conflicted with and blocked reliable loading on this page. -->
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    /* Direct @font-face — loads the full variable fonts reliably. Google Fonts' lazy per-weight
       loading intermittently fails to apply on this HubSpot page, so we declare the faces here. */
    @font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url('https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7W0Q5nw.woff2') format('woff2');}
    @font-face{font-family:'Roboto Slab';font-style:normal;font-weight:100 900;font-display:swap;src:url('https://fonts.gstatic.com/s/robotoslab/v36/BngMUXZYTXPIvIBgJJSb6ufN5qWr4xCC.woff2') format('woff2');}
    :root{
      --teal:#1a9fbd;          /* primary accent (matches blog listing) */
      --teal-dark:#127f99;
      --line:#e7ebee;
      --sans:'Inter','Helvetica Neue',Arial,sans-serif;
    }
    body {
      margin: 0;
      font-family: 'Roboto Slab', Georgia, 'Times New Roman', serif;
      color: #212529;
      background: #fff;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }
    img { border-radius: 0 !important; } /* all images render with square corners */
    /* ── Typography helpers ── */
    .graphik { font-family: 'Inter', 'Inter', Arial, sans-serif; }
    /* ─────────────────────────────────────────────
       NAV ROW 1 — Primary menu (matches blog listing page)
    ───────────────────────────────────────────── */
    .nav{ border-bottom:1px solid var(--line); background:#fff; }
    .nav__inner{ display:flex; align-items:center; gap:28px; max-width:1280px; margin:0 auto; padding:18px 40px; }
    .nav__menu{ display:flex; align-items:center; gap:26px; list-style:none; margin:0; padding:0; flex:1; }
    .nav__menu > li{ position:relative; }
    .nav__link{ font-family:var(--sans); font-size:15px; color:#73797e; text-decoration:none; white-space:nowrap; }
    .nav__link:hover{ color:var(--teal); }
    .nav__menu > li:hover .nav__dd{ display:block; }
    /* Transparent bridge across the 14px gap so the dropdown stays open while the cursor moves onto it */
    .nav__dd::before{ content:""; position:absolute; left:0; right:0; top:-14px; height:14px; }
    .nav__dd{ display:none; position:absolute; top:100%; left:0; margin-top:14px; background:#fff; border:1px solid var(--line);
      list-style:none; padding:6px 0; min-width:210px; z-index:200; box-shadow:0 10px 30px rgba(20,40,60,.10); border-radius:8px; }
    .nav__dd li a{ display:block; padding:9px 18px; font-family:var(--sans); font-size:14px; color:#2b3137; text-decoration:none; }
    .nav__dd li a:hover{ background:#f5fafc; color:var(--teal); }
    .nav__right{ display:flex; align-items:center; gap:18px; }
    .nav__cta{ display:inline-flex; align-items:center; gap:10px; background:#0096b7; color:#fff; text-decoration:none; font-family:var(--sans); font-size:14px; font-weight:600; text-transform:uppercase; letter-spacing:normal; padding:13px 16px; border-radius:8px; white-space:nowrap; }
    .nav__cta svg{ flex-shrink:0; }
    .nav__cta:hover{ background:#007e99; }
    /* ─────────────────────────────────────────────
       NAV ROW 2 — Secondary menu, right-aligned (matches blog listing sub-nav)
    ───────────────────────────────────────────── */
    .subnav{ border-bottom:1px solid var(--line); background:#fff; }
    .subnav__inner{ display:flex; justify-content:center; max-width:1280px; margin:0 auto; padding:0 40px; }
    .subnav__menu{ display:flex; align-items:center; gap:22px; list-style:none; margin:0; padding:0; }
    .subnav__menu > li{ position:relative; }
    .subnav__link{ display:flex; align-items:center; height:48px; font-family:var(--sans); font-size:14px; color:#52606b; text-decoration:none; white-space:nowrap; }
    .subnav__link:hover{ color:var(--teal); }
    .subnav__menu > li:hover .subnav__dd{ display:block; }
    .subnav__dd{ display:none; position:absolute; top:100%; right:0; background:#fff; border:1px solid var(--line); list-style:none;
      margin:0; padding:6px 0; min-width:220px; z-index:200; box-shadow:0 10px 30px rgba(20,40,60,.10); border-radius:8px; }
    .subnav__dd li a{ display:block; padding:9px 18px; font-family:var(--sans); font-size:14px; color:#2b3137; text-decoration:none; }
    .subnav__dd li a:hover{ background:#f5fafc; color:var(--teal); }
    /* Hide the embedded video (a drag-and-drop oembed module that can't be removed from template markup) */
    .dnd-section:has(.oembed_container){ display:none !important; }
    /* ── Override drag-and-drop page-content teal eyebrow labels to match the blog listing eyebrow ──
       These labels are page content (inline-styled), so they can't be changed from the template markup
       on an already-published page — this rule restyles them via CSS, which does reach the page. ── */
    [style*="0096b7"]{
      color:#1a9fbd !important;
      font-weight:700 !important;
      letter-spacing:.18em !important;
      font-family:'Inter','Helvetica Neue',Arial,sans-serif !important;
    }
    /* ── Page layout ── */
    .page-outer {
      max-width: 1440px;
      margin: 0 auto;
    }
    .page-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 80px;
    }
    /* ── Section titles ── */
    .section-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      padding: 40px 0 20px;
      border-top: 1px solid #e4e7ec;
      border-bottom: 1px solid #e4e7ec;
    }
    .section-title {
      font-family: 'Roboto Slab', Georgia, serif;
      font-size: 32px;
      font-weight: 600;
      color: #000;
      text-align: center;
      text-transform: uppercase;
      letter-spacing: -0.64px;
      line-height: 38px;
      margin: 0;
    }
    .section-subtitle {
      font-family: 'Inter', Arial, sans-serif;
      font-size: 11px;
      font-weight: 500;
      color: #1a9fbd;
      text-transform: uppercase;
      letter-spacing: 0.88px;
      line-height: 18px;
      text-align: center;
      margin: 0;
    }
    /* ── Footer ── */
    .site-footer { background: #f4f4f4; border-top: 1px solid #e4e7ec; }
    .footer-cols {
      display: flex;
      padding: 0 80px;
      max-width: 1440px;
      margin: 0 auto;
    }
    .footer-col {
      flex: 1;
      padding: 16px 16px 20px;
      border-right: 1px solid #e4e7ec;
    }
    .footer-col:first-child { padding-left: 0; }
    .footer-col:last-child { border-right: none; padding-right: 0; }
    .footer-col h4 {
      font-family: 'Roboto Slab', Georgia, serif;
      font-size: 24px;
      font-weight: 600;
      color: #000;
      line-height: 32px;
      margin: 20px 0 16px;
    }
    .footer-col ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .footer-col li a {
      font-family: 'Roboto Slab', Georgia, serif;
      font-size: 16px;
      font-weight: 500;
      color: #73797e;
      text-decoration: none;
      line-height: 24px;
    }
    .footer-col li a:hover { color: #1a9fbd; }
    .footer-newsletter {
      background: #e9e9e9;
      padding: 0 80px 20px;
      max-width: 1440px;
      margin: 0 auto;
    }
    .footer-newsletter__row {
      border-top: 1px solid #e4e7ec;
      border-bottom: 1px solid #e4e7ec;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      padding: 40px 0 20px;
    }
    .footer-newsletter__title {
      font-family: 'Roboto Slab', Georgia, serif;
      font-size: 32px;
      font-weight: 600;
      color: #000;
      text-transform: uppercase;
      letter-spacing: -0.64px;
      line-height: 38px;
      margin: 0;
      white-space: pre-line;
    }
    .footer-newsletter__form { display: flex; gap: 8px; align-items: center; }
    .footer-newsletter__input {
      padding: 16px;
      font-family: 'Inter', Arial, sans-serif;
      font-size: 16px;
      border: 1px solid #98a2b3;
      border-radius: 4px;
      width: 404px;
      outline: none;
      line-height: 24px;
    }
    .footer-newsletter__btn {
      padding: 16px;
      font-family: 'Inter', Arial, sans-serif;
      font-size: 16px;
      background: #fff;
      border: 1px solid #98a2b3;
      border-radius: 4px;
      cursor: pointer;
      line-height: 24px;
    }
    .footer-newsletter__btn:hover { background: #f9fafb; }
    .footer-bottom {
      background: #e9e9e9;
      padding: 16px 80px;
      max-width: 1440px;
      margin: 0 auto;
    }
    .footer-bottom__inner {
      display: flex;
      justify-content: space-between;
      font-family: 'Roboto Slab', Georgia, serif;
      font-size: 16px;
      font-weight: 500;
      color: #1d2939;
      line-height: 24px;
    }
    /* ── CTA button (matches blog listing teal button) ── */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--teal);
      color: #fff;
      padding: 12px 22px;
      font-family: var(--sans);
      font-size: 15px;
      text-decoration: none;
      border-radius: 6px;
      line-height: 24px;
      gap: 8px;
    }
    .btn-primary:hover { background: var(--teal-dark); }
    @media (max-width: 1100px) {
      .nav__inner,
      .subnav__inner,
      .page-inner,
      .footer-cols,
      .footer-newsletter,
      .footer-bottom { padding-left: 24px; padding-right: 24px; }
      .footer-cols { flex-wrap: wrap; }
    }
    @media (max-width: 768px) {
      .nav__menu,
      .subnav__menu { display: none; }
      .footer-col { width: 50%; flex: none; }
      .footer-newsletter__row { flex-direction: column; gap: 24px; }
      .footer-newsletter__input { width: 100%; }
    }
    /* ── Header/hero image sits in a flexbox module that shrink-wraps it tiny.
       Switch that module to normal flow (no :has(), so it works on older iOS Safari)
       and let the image span the content width. ── */
    .widget_1781312074965-flexbox-positioning { display: block !important; }
    .widget_1781312074965-flexbox-positioning .hs_cos_wrapper_type_linked_image,
    .widget_1781312074965-flexbox-positioning .widget-type-linked_image { display: block !important; width: 100% !important; max-width: 100% !important; }
    .widget_1781312074965-flexbox-positioning img { width: 100% !important; max-width: 960px !important; height: auto !important; display: block !important; margin: 0 auto !important; }
    /* ── Responsive fixes for the drag-and-drop text blocks ──
       Several content sections carry hard-coded desktop side paddings / fixed widths
       in their inline styles (padding:0 390px, padding:0 80px, width:628px). Those
       don't shrink on their own, so on tablet and mobile they squeeze the text into a
       sliver and overflow off-screen. Collapse them to sensible gutters at narrow
       widths. (These selectors only match those specific blocks — the cards use
       different padding values and are unaffected.) */
    @media (max-width: 1100px) {
      [style*="0 390px"],
      [style*="0 80px"] { padding-left: 24px !important; padding-right: 24px !important; }
      [style*="628px"] { width: auto !important; max-width: 100% !important; }
      /* Never let an image push a column wider than the screen */
      .dnd-module img, .widget-span img { max-width: 100% !important; height: auto !important; }
    }
    @media (max-width: 820px) {
      /* Audience illustrations are a hard-coded 224px wide — let them fill the column on
         mobile so they scale up and line up with the text instead of floating small. */
      .dnd-module img[width="224"] { width: 100% !important; height: auto !important; display: block; }
      /* Stacked cards: the between-column dividers become stray vertical lines on mobile,
         and the equal-height forces big gaps — drop both. */
      [style*="border-left: 1px solid #e4e7ec"] { border-left: 0 !important; }
      [style*="min-height: 225px"] { min-height: 0 !important; }
      /* Kill the hard-coded 80px side paddings that shove the audience modules around. */
      .dnd-section [style*="80px"] { padding-left: 16px !important; padding-right: 16px !important; }
    }
    @media (max-width: 600px) {
      [style*="0 390px"],
      [style*="0 80px"] { padding-left: 16px !important; padding-right: 16px !important; }
    }
    .cureus-aud{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:2rem 1.5rem;width:100%;max-width:1280px;margin:0 auto;padding:0 1.5rem;box-sizing:border-box;}
    .cureus-aud *{box-sizing:border-box;max-width:100%;}
    .cureus-aud__img{width:100%;aspect-ratio:4/3;object-fit:cover;display:block;margin:0 0 1rem;background:#eef4f7;border-radius:0;}
    .cureus-aud__num{font-family:'Inter',Arial,sans-serif;font-size:.7rem;font-weight:700;color:#1a9fbd;letter-spacing:.18em;text-transform:uppercase;margin:0 0 .5rem;}
    .cureus-aud__title{font-family:'Roboto Slab',Georgia,serif;font-size:1.25rem;font-weight:600;color:#000;text-transform:uppercase;line-height:1.3;margin:0 0 .5rem;}
    .cureus-aud__text{font-family:'Roboto Slab',Georgia,serif;font-size:1rem;color:#777;line-height:1.4;margin:0;}
    @media (max-width:820px){.cureus-aud{grid-template-columns:1fr;}.cureus-aud__card{max-width:420px;margin-left:auto;margin-right:auto;}}
  </style>
</head>
<body>
{# ── NAV ROW 1: Primary menu (matches blog listing page) ─────────────────── #}
{% set primary_menu = menu(213273198154) %}
<nav class="nav" aria-label="Primary navigation">
