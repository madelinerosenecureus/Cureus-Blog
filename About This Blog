<!-- Mobile navigation (hamburger) — builds a mobile menu from the existing nav on small screens -->
<style>
  .nav__toggle{ display:none; align-items:center; justify-content:center; width:42px; height:42px; padding:0; border:1px solid var(--line); border-radius:8px; background:#fff; color:#2b3137; cursor:pointer; }
  .nav__toggle svg{ display:block; }
  #cureusMobileMenu{ display:none; border-bottom:1px solid var(--line); background:#fff; }
  #cureusMobileMenu.is-open{ display:block; }
  #cureusMobileMenu ul{ list-style:none; margin:0; padding:8px 0; }
  #cureusMobileMenu a{ display:block; padding:11px 24px; font-family:var(--sans); font-size:15px; color:#2b3137; text-decoration:none; }
  #cureusMobileMenu a:hover{ background:#f5fafc; color:var(--teal); }
  #cureusMobileMenu a.is-child{ padding-left:44px; font-size:14px; color:#52606b; }
  #cureusMobileMenu .sep{ height:1px; background:var(--line); margin:6px 0; }
  @media (max-width:820px){
    .nav__menu, .subnav__menu{ display:none !important; }
    .nav__toggle{ display:inline-flex; }
    .nav__right{ margin-left:auto; }
  }
</style>
<script>
(function(){
  function init(){
    var navInner=document.querySelector('.nav__inner');
    if(!navInner||document.querySelector('.nav__toggle'))return;
    var btn=document.createElement('button');
    btn.type='button';btn.className='nav__toggle';btn.setAttribute('aria-label','Menu');btn.setAttribute('aria-expanded','false');
    btn.innerHTML='<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>';
    navInner.insertBefore(btn,navInner.firstChild);
    var panel=document.createElement('nav');panel.id='cureusMobileMenu';panel.setAttribute('aria-label','Mobile menu');
    var ul=document.createElement('ul');
    function addLink(a,child){if(!a)return;var li=document.createElement('li');var na=document.createElement('a');na.href=a.getAttribute('href')||'#';na.textContent=(a.textContent||'').trim();if(child)na.className='is-child';li.appendChild(na);ul.appendChild(li);}
    function addMenu(menu,ddSel){if(!menu)return;menu.querySelectorAll(':scope > li').forEach(function(li){addLink(li.querySelector(':scope > a'),false);var dd=li.querySelector(ddSel);if(dd){dd.querySelectorAll('li > a').forEach(function(ca){addLink(ca,true);});}});}
    addMenu(document.querySelector('.nav__menu'),'.nav__dd');
    var sub=document.querySelector('.subnav__menu');
    if(sub&&sub.querySelector('li')){var sep=document.createElement('li');sep.innerHTML='<div class="sep"></div>';ul.appendChild(sep);addMenu(sub,'.subnav__dd');}
    panel.appendChild(ul);
    var anchor=document.querySelector('.subnav')||document.querySelector('.nav');
    anchor.parentNode.insertBefore(panel,anchor.nextSibling);
    btn.addEventListener('click',function(){var open=panel.classList.toggle('is-open');btn.setAttribute('aria-expanded',open?'true':'false');});
  }
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>
<script>
/* Link target policy: menu links and links that stay within the blog (reading a post,
   category/tag pages, pagination, search) open in the SAME tab. Every link that leaves
   the blog — the main Cureus site, the logo, footer, social, external references — opens
   in a NEW tab so the blog stays open. */
(function(){
  var host = location.hostname;
  function inMenu(a){
    return a.closest('.nav__menu') || a.closest('.subnav__menu') || a.closest('#cureusMobileMenu');
  }
  function apply(){
    document.querySelectorAll('a[href]').forEach(function(a){
      if (a.dataset.tabDone) return;
      if (inMenu(a)) { a.dataset.tabDone='1'; return; }            // menu links: same tab
      var raw = a.getAttribute('href') || '';
      if (!raw || raw.charAt(0)==='#' || /^(javascript:|mailto:|tel:)/i.test(raw)) { a.dataset.tabDone='1'; return; }
      var url; try { url = new URL(a.href, location.href); } catch(e){ a.dataset.tabDone='1'; return; }
      if (url.protocol !== 'http:' && url.protocol !== 'https:') { a.dataset.tabDone='1'; return; }
      // Leaves the blog when: different host, OR footer link, OR the site logo.
      var leavesBlog = (url.hostname !== host) || !!a.closest('.site-footer') || a.classList.contains('nav__logo');
      if (leavesBlog) { a.setAttribute('target','_blank'); a.setAttribute('rel','noopener noreferrer'); }
      a.dataset.tabDone='1';
    });
  }
  apply();
  if (document.readyState==='loading') document.addEventListener('DOMContentLoaded', apply);
  window.addEventListener('load', apply);   // catch the mobile menu built on load
})();
</script>

