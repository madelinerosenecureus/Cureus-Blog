    <script>
      /* Keep the Previous/Next post cards equal height so their buttons line up,
         regardless of how many lines each title wraps to (no title truncation). */
      (function () {
        function equalize() {
          var prev = document.querySelector('.article-aside-prev .aside-card');
          var next = document.querySelector('.article-aside-next .aside-card');
          if (!prev || !next) { return; }
          prev.style.minHeight = '';
          next.style.minHeight = '';
          if (window.innerWidth <= 560) { return; } /* stacked on small screens — no need */
          var h = Math.max(prev.offsetHeight, next.offsetHeight);
          prev.style.minHeight = h + 'px';
          next.style.minHeight = h + 'px';
        }
        window.addEventListener('load', equalize);
        window.addEventListener('resize', equalize);
      })();
    </script>
    <script>
      /* Fix the missing space in the native HubSpot "Reply to<Name>" comment buttons. */
      (function () {
        function fixReplySpacing() {
          var wrap = document.querySelector('.blog-comments-wrapper');
          if (!wrap) { return; }
          wrap.querySelectorAll('a, button').forEach(function (el) {
            if (!/reply to\S/i.test(el.textContent || '')) { return; } /* only the ones missing the space */
            el.childNodes.forEach(function (node) {
              if (node.nodeType !== 3) { return; } /* text nodes only */
              var t = node.textContent;
              var fixed = t.replace(/(reply to)(\S)/i, '$1 $2');
              if (fixed === t && /\bto$/i.test(t.trim()) && !/\s$/.test(t) && node.nextSibling) { fixed = t + ' '; }
              if (fixed !== t) { node.textContent = fixed; }
            });
          });
        }
        fixReplySpacing();
        window.addEventListener('load', fixReplySpacing);
        var n = 0, t = setInterval(function () { fixReplySpacing(); if (++n > 10) { clearInterval(t); } }, 500);
      })();
    </script>
    <!-- Mobile navigation (hamburger) — builds a mobile menu from the existing nav on small screens -->
    <style>
      .nav__toggle{ display:none; align-items:center; justify-content:center; width:42px; height:42px; padding:0; border:1px solid var(--line); border-radius:8px; background:#fff; color:#2b3137; cursor:pointer; }
