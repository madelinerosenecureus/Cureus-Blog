      .footer-bottom { border-top: 1px solid #e2e5e8; }
      .footer-bottom__inner { max-width: var(--maxw); margin: 0 auto; padding: 18px 40px; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-family: var(--sans); font-size: 13px; color: #6b7278; }
      .footer-bottom__inner a { color: #6b7278; text-decoration: none; }
      .footer-bottom__inner a:hover { color: var(--teal); }

      /* ─────────────────────────  RESPONSIVE  ───────────────────────── */
      @media (max-width: 1000px) {
        .similar-section .cards { grid-template-columns: repeat(2, 1fr); }
      }
      @media (max-width: 820px) {
        .nav__menu, .subnav__menu { display: none; }
        .footer-cols { flex-wrap: wrap; gap: 24px 0; }
        .footer-col { flex: 1 1 45%; border-right: none; padding: 0; }
