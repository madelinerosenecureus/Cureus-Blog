    <main>
      {# ---------------------------------------------------------------
         Previous / Next articles by publish date. blog_recent_posts is
         ordered newest-first, so the item just BEFORE the current post
         in the list was published AFTER it (Next Article), and the item
         just AFTER it was published BEFORE it (Previous Article).
         List-append is used to hoist values out of the loop scope.
         --------------------------------------------------------------- #}
      {% set _all_posts = blog_recent_posts(group.id, 300) %}
      {% set _newer_holder = [] %}
      {% set _older_holder = [] %}
      {% for p in _all_posts %}
        {% if p.id == content.id %}
          {% if not loop.first %}{% do _newer_holder.append(_all_posts[loop.index0 - 1]) %}{% endif %}
          {% if not loop.last %}{% do _older_holder.append(_all_posts[loop.index0 + 1]) %}{% endif %}
        {% endif %}
      {% endfor %}
      {% set newer_post = _newer_holder[0] if _newer_holder|length > 0 else none %}
      {% set older_post = _older_holder[0] if _older_holder|length > 0 else none %}

      {# ---------------------------------------------------------------
         Similar Posts: for each tag on the current post, pull recent
         posts carrying that tag, merge, drop the current post, dedupe,
         cap at 3. Earlier tags take priority.
         --------------------------------------------------------------- #}
      {% set similar_posts = [] %}
      {% set seen_post_ids = [] %}
      {% if content.tag_list %}
        {% for tag in content.tag_list %}
          {% set tag_posts = blog_recent_tag_posts('default', tag.slug, 5) %}
          {% for post in tag_posts %}
            {% if post.id != content.id and post.id not in seen_post_ids and similar_posts|length < 3 %}
              {% do seen_post_ids.append(post.id) %}
              {% do similar_posts.append(post) %}
            {% endif %}
          {% endfor %}
        {% endfor %}
      {% endif %}
      {% set has_similar = similar_posts|length > 0 %}

      {# Reading time (words / 200, rounded up, minimum 1) #}
      {% set _words = content.post_body|striptags|wordcount %}
      {% set _rt = (_words / 200)|round(0, 'ceil')|int %}
      {% if _rt < 1 %}{% set _rt = 1 %}{% endif %}

      {# ---------------------------------------------------------------
         Article shell: the article sits in the center column with the
         Previous Post (older) card as the left rail and the Next Post
         (newer) card as the right rail, both aligned to the top of the
         article. On narrow screens the rails collapse to a row above the
         article. When there is no adjacent post the rail is simply empty
         and the article stays centered.
         --------------------------------------------------------------- #}
      <div class="article-shell">
        {% if older_post %}
          <aside class="article-aside article-aside-prev">
            <a class="aside-card" href="{{ older_post.absolute_url }}">
              {% if older_post.featured_image %}
                <span class="aside-card-thumb">
                  <img src="{{ older_post.featured_image }}" alt="{{ older_post.featured_image_alt_text|default(older_post.name)|escape_attr }}" loading="lazy" />
                </span>
              {% endif %}
              <span class="aside-card-body">
                <span class="aside-card-eyebrow">
                  {% if older_post.blog_post_author %}<span class="aside-card-tag">{{ older_post.blog_post_author.display_name }}</span><span class="aside-card-eyebrow-sep">·</span>{% endif %}<span class="aside-card-eyebrow-date">{{ older_post.publish_date|datetimeformat('%B %e, %Y') }}</span>
                </span>
                <span class="aside-card-name">{{ older_post.name }}</span>
                <span class="aside-card-btn">Previous Post</span>
              </span>
            </a>
          </aside>
        {% endif %}

        <article class="cureus-blog-post">
        {% if content.featured_image %}
          <div class="blog-featured-image">
            <img
              src="{{ content.featured_image }}"
              alt="{{ content.featured_image_alt_text|default(content.name)|escape_attr }}"
            />
          </div>
        {% endif %}
        <div class="blog-post-eyebrow">
          <a class="blog-post-eyebrow-author" href="{{ blog_author_url(group.id, content.blog_post_author.slug) }}" rel="author">
            {{ content.blog_post_author.display_name }}
          </a>
          <span class="blog-post-eyebrow-sep">·</span>
          <time class="blog-post-eyebrow-date" datetime="{{ content.publish_date }}">
            {{ content.publish_date|datetimeformat('%B %e, %Y') }}
          </time>
        </div>
        <h1 class="blog-post-title">{{ content.name }}</h1>
        <div class="blog-post-metabar">
          <span class="blog-read-time">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><polyline points="12 8 12 12 15 14"></polyline></svg>
            {{ _rt }} min read
          </span>
          <div class="blog-social-share-links" aria-label="Share this article">
            <a
              class="blog-social-share-link blog-social-share-linkedin"
              href="https://www.linkedin.com/shareArticle?mini=true&amp;url={{ content.absolute_url|urlencode }}&amp;title={{ content.name|urlencode }}"
              target="_blank" rel="noopener noreferrer" aria-label="Share on LinkedIn" title="Share on LinkedIn"
            ><span class="screen-reader-text">LinkedIn</span></a>
            <a
              class="blog-social-share-link blog-social-share-x"
              href="https://twitter.com/intent/tweet?url={{ content.absolute_url|urlencode }}&amp;text={{ content.name|urlencode }}"
              target="_blank" rel="noopener noreferrer" aria-label="Share on X" title="Share on X"
            ><span class="screen-reader-text">X</span></a>
            <a
              class="blog-social-share-link blog-social-share-facebook"
              href="https://www.facebook.com/sharer/sharer.php?u={{ content.absolute_url|urlencode }}"
              target="_blank" rel="noopener noreferrer" aria-label="Share on Facebook" title="Share on Facebook"
            ><span class="screen-reader-text">Facebook</span></a>
            <a
              class="blog-social-share-link blog-social-share-email"
              href="mailto:?subject={{ content.name|urlencode }}&amp;body={{ content.absolute_url|urlencode }}"
              aria-label="Share by email" title="Share by email"
            ><span class="screen-reader-text">Email</span></a>
          </div>
        </div>
        <div class="blog-post-body">
          {{ content.post_body }}
        </div>
        {% if content.tag_list %}
          <div class="blog-post-tags">
            {% for tag in content.tag_list %}
              <a href="{{ blog_tag_url(group.id, tag.slug) }}" rel="tag">{{ tag.name }}</a>
            {% endfor %}
          </div>
        {% endif %}
        </article>

        {% if newer_post %}
          <aside class="article-aside article-aside-next">
            <a class="aside-card" href="{{ newer_post.absolute_url }}">
              {% if newer_post.featured_image %}
                <span class="aside-card-thumb">
                  <img src="{{ newer_post.featured_image }}" alt="{{ newer_post.featured_image_alt_text|default(newer_post.name)|escape_attr }}" loading="lazy" />
                </span>
              {% endif %}
              <span class="aside-card-body">
                <span class="aside-card-eyebrow">
                  {% if newer_post.blog_post_author %}<span class="aside-card-tag">{{ newer_post.blog_post_author.display_name }}</span><span class="aside-card-eyebrow-sep">·</span>{% endif %}<span class="aside-card-eyebrow-date">{{ newer_post.publish_date|datetimeformat('%B %e, %Y') }}</span>
                </span>
                <span class="aside-card-name">{{ newer_post.name }}</span>
                <span class="aside-card-btn">Next Post</span>
              </span>
            </a>
          </aside>
        {% endif %}
      </div>

      {# ── SIMILAR POSTS (bottom card row, tag-based) ── #}
      {% if has_similar %}
        <section class="similar-section" aria-label="Similar posts">
          <div class="similar-inner">
            <div class="section__head">
              <div>
                <h2 class="section__title">Similar Posts</h2>
                <p class="section__sub">Related reading based on this article's topics</p>
              </div>
            </div>
            <div class="cards">
              {% for post in similar_posts %}
                <article class="card">
                  <a href="{{ post.absolute_url }}">
                    {% if post.featured_image %}
                      <img class="card__img" src="{{ post.featured_image }}" alt="{{ post.featured_image_alt_text|default(post.name)|escape_attr }}" loading="lazy" />
                    {% else %}
                      <span class="card__img"></span>
                    {% endif %}
                  </a>
                  <div class="card__meta">
                    {% if post.tag_list %}<span class="card__tag">{{ post.tag_list[0].name }}</span>{% endif %}
                    <span class="card__date">{{ post.publish_date|datetimeformat('%B %e, %Y') }}</span>
                  </div>
                  <h3 class="card__title"><a href="{{ post.absolute_url }}">{{ post.name }}</a></h3>
                  {% set _sw = post.post_body|striptags|wordcount %}{% set _srt = (_sw / 200)|round(0, 'ceil')|int %}{% if _srt < 1 %}{% set _srt = 1 %}{% endif %}
                  <div class="card__stats">
                    <span class="stat"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><polyline points="12 8 12 12 15 14"></polyline></svg>{{ _srt }} min read</span>
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
        </section>
      {% endif %}

      {% if group.allow_comments %}
        <div class="blog-comments-wrapper">
          <div class="blog-comments-intro">
            <h2>Join the discussion</h2>
            <p>Add your email, first name, and last name to leave a comment.</p>
          </div>
          <div class="blog-comments-module">
            {% module 'blog_comments' path='@hubspot/blog_comments', label="Blog comments" %}
          </div>
        </div>
      {% endif %}
    </main>

