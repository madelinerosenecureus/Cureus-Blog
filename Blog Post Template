    {# ─────────────────────────  BREADCRUMBS  ───────────────────────── #}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <div class="breadcrumbs__inner">
        <a href="{{ group.absolute_url }}">Blog Home</a>
        {% if content.tag_list %}
          <span class="breadcrumbs__sep" aria-hidden="true">&rsaquo;</span>
          <a href="{{ blog_tag_url(group.id, content.tag_list[0].slug) }}">{{ content.tag_list[0].name }}</a>
        {% endif %}
        <span class="breadcrumbs__sep" aria-hidden="true">&rsaquo;</span>
        <span class="breadcrumbs__current" aria-current="page">{{ content.name }}</span>
      </div>
